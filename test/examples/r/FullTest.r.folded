 0 400 400   # coding:utf-8
 0 400 400   ### hexadecimal floating-point numbers styled 5 SCE_R_NUMBER
 1 400 400   
 0 400 400   # point followed by a digit
 0 400 400   0x1.3ae147ae147aep+0 + 0x1.23d70a3d70a3dp+2i # 1.23 + 4.56i
 1 400 400   
 0 400 400   # point not followed by a digit
 0 400 400   0x1.ccccccccccccdp-1 + 0x1.ccccccccccccdp-1i # 0.9 + 0.9i
 0 400 400   0x1.ccccccccccccdp-1
 1 400 400   
 0 400 400   # upper case letters:
 0 400 400   0X1.CCCCCCCCCCCCDP-1 # 0.9
 0 400 400   0X1.1CCCCCCCCCCCDP-1
 1 400 400   
 0 400 400   # imaginary numbers
 0 400 400   0x.1p1i
 0 400 400   0x0.1p1i
 0 400 400   0xa.1p1i
 0 400 400   0xa.a1p1i
 1 400 400   
 1 400 400   
 1 400 400   
 0 400 400   ### identifiers styled 9 SCE_R_IDENTIFIER
 1 400 400   
 0 400 400   # identifiers can start with a letter or a dot:
 0 400 400   .a._x123
 0 400 400   ..a
 0 400 400   ._1
 1 400 400   
 0 400 400   # identifiers must not start with an underscore or a digit:
 0 400 400   _1test._x
 0 400 400   __a__
 0 400 400   2values
 1 400 400   
 1 400 400   
 1 400 400   
 0 400 400   ### dot-dot-dot styling
 1 400 400   
 0 400 400   # styled 2 SCE_R_KWORD because they are reserved words
 0 400 400   ..1
 0 400 400   ..2
 0 400 400   ..123
 0 400 400   ...
 0 400 400   # these are 9 SCE_R_IDENTIFIER because they are just identifiers
 0 400 400   ._
 0 400 400   ..
 0 400 400   ....
 0 400 400   ...object
 0 400 400   ...2.objects
 0 400 400   ..._objectname_.1
 1 400 400   
 1 400 400   
 1 400 400   
