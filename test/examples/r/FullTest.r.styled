{1}### hexadecimal floating-point numbers styled 5 SCE_R_NUMBER{0}

{1}# point followed by a digit{0}
{5}0x1.3ae147ae147aep+0{0} {8}+{0} {5}0x1.23d70a3d70a3dp+2i{0} {1}# 1.23 + 4.56i{0}

{1}# point not followed by a digit{0}
{5}0x1.ccccccccccccdp-1{0} {8}+{0} {5}0x1.ccccccccccccdp-1i{0} {1}# 0.9 + 0.9i{0}
{5}0x1.ccccccccccccdp-1{0}

{1}# upper case letters:{0}
{5}0X1.CCCCCCCCCCCCDP-1{0} {1}# 0.9{0}
{5}0X1.1CCCCCCCCCCCDP-1{0}

{1}# imaginary numbers{0}
{5}0x.1p1i{0}
{5}0x0.1p1i{0}
{5}0xa.1p1i{0}
{5}0xa.a1p1i{0}



{1}### identifiers styled 9 SCE_R_IDENTIFIER{0}

{1}# identifiers can start with a letter or a dot:{0}
{9}.a._x123{0}
{9}..a{0}
{9}._1{0}
{9}base{8}::{16}.__S3MethodsTable__.{0}   {1}# .__S3MethodsTable__. is 16 SCE_R_NONFUNOBJECTS (exported object of base){0}
{16}.GlobalEnv{0}                   {1}# 16 because .GlobalEnv is an environment{0}
{16}.GlobalEnv{8}${9}.Random.seed{0}

{1}# identifiers must not start with an underscore or a digit:{0}
{8}_{5}1{9}test._x{0}
{8}__{9}a__{0}
{5}2{9}values{0}



{1}### dot-dot-dot styling{0}

{1}# styled 2 SCE_R_KWORD because they are reserved words{0}
{2}..1{0}
{2}..2{0}
{2}..123{0}
{2}...{0}
{1}# these are 9 SCE_R_IDENTIFIER because they are just identifiers{0}
{9}._{0}
{9}..{0}
{9}....{0}
{9}...object{0}
{9}...2.objects{0}
{9}..._objectname_.1{0}



{1}### non-ASCII characters{0}

{9}nem_egyenlő{0} {8}<-{0} {5}5L{0} {8}!={0} {5}1L{0} {1}# Hungarian{0}
{9}größer{0}      {8}<-{0} {5}5L{0} {8}>{0} {5}1L{0}  {1}# German umlaut and eszett{0}
{9}мање{0}        {8}<-{0} {5}1L{0} {8}<{0} {5}5L{0}  {1}# Serbian Cyrillic{0}



